    "# Notebook 03 — SHAP Explanations for Audio Classification\n",
    "### XAI for Music Genre Classification | GTZAN Dataset\n",
    "---\n",
    "**Purpose:** Apply SHAP (SHapley Additive exPlanations) to the trained CNN to identify *which regions* of the mel spectrogram drive genre predictions.\n",
    "\n",
    "**Research Question:** Do highlighted regions correspond to musicologically meaningful features (rhythm, harmony, timbre) or to spurious correlations (recording noise, silence)?\n",
    "\n",
    "**Outputs:**\n",
    "- `../figures/03_shap_*.png` — HD SHAP overlay visualisations per genre\n",
    "- `../data/shap_values.pkl` — serialised SHAP arrays for quantitative analysis in NB05"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 1: Installs ──────────────────────────────────────────────────────────\n",
    "import subprocess, sys\n",
    "for pkg in ['shap', 'torch', 'librosa', 'numpy', 'pandas', 'matplotlib', 'tqdm', 'scikit-learn']:\n",
    "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', pkg])\n",
    "print('Done.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 2: Imports & config ──────────────────────────────────────────────────\n",
    "import os, pickle, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import librosa.display\n",
    "import shap\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 300, 'savefig.dpi': 300,\n",
    "    'font.family': 'DejaVu Sans', 'font.size': 12,\n",
    "    'axes.titlesize': 13, 'axes.labelsize': 12,\n",
    "    'xtick.labelsize': 10, 'ytick.labelsize': 10,\n",
    "    'axes.spines.top': False, 'axes.spines.right': False,\n",
    "})\n",
    "\n",
    "FIGURES = Path('../figures')\n",
    "MODELS  = Path('../models')\n",
    "DATA    = Path('../data')\n",
    "\n",
    "DEVICE = ('mps' if torch.backends.mps.is_available() else\n",
    "          'cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {DEVICE}')\n",
    "\n",
    "GENRES = ['blues','classical','country','disco','hiphop',\n",
    "          'jazz','metal','pop','reggae','rock']\n",
    "\n",
    "SR, N_MELS, HOP, N_FFT = 22050, 128, 512, 2048\n",
    "SEG_S = 3.0\n",
    "FIXED_W = 128\n",
    "\n",
    "def savefig(name, fig=None):\n",
    "    if fig is None: fig = plt.gcf()\n",
    "    path = FIGURES / f'{name}.png'\n",
    "    fig.savefig(path, dpi=300, bbox_inches='tight', facecolor='white')\n",
    "    print(f'  ✓ Saved {path}')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 3: Re-instantiate model & load weights ───────────────────────────────\n",
    "class MusicCNN(nn.Module):\n",
    "    def __init__(self, n_classes=10, dropout=0.4):\n",
    "        super().__init__()\n",
    "        def conv_block(in_ch, out_ch):\n",
    "            return nn.Sequential(\n",
    "                nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),\n",
    "                nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\n",
    "                nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),\n",
    "                nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\n",
    "                nn.MaxPool2d(2), nn.Dropout2d(p=0.15),\n",
    "            )\n",
    "        self.block1 = conv_block(1, 32)\n",
    "        self.block2 = conv_block(32, 64)\n",
    "        self.block3 = conv_block(64, 128)\n",
    "        self.pool   = nn.AdaptiveAvgPool2d((4, 4))\n",
    "        self.flat   = nn.Flatten()\n",
    "        self.head   = nn.Sequential(\n",
    "            nn.Linear(128 * 4 * 4, 256), nn.ReLU(inplace=True),\n",
    "            nn.Dropout(dropout), nn.Linear(256, n_classes)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        x = self.block1(x); x = self.block2(x); x = self.block3(x)\n",
    "        x = self.pool(x); x = self.flat(x)\n",
    "        return self.head(x)\n",
    "\n",
    "model = MusicCNN().to(DEVICE)\n",
    "model.load_state_dict(torch.load(MODELS / 'cnn_gtzan_best.pt', map_location=DEVICE))\n",
    "model.eval()\n",
    "\n",
    "with open(MODELS / 'label_encoder.pkl', 'rb') as f:\n",
    "    le = pickle.load(f)\n",
    "\n",
    "print('Model loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 4: Helper — load clip as spectrogram tensor ─────────────────────────\n",
    "def load_spectrogram(filepath, start_s=0.0):\n",
    "    y, _ = librosa.load(filepath, sr=SR, offset=start_s, duration=SEG_S)\n",
    "    if len(y) < int(SEG_S * SR):\n",
    "        y = np.pad(y, (0, int(SEG_S * SR) - len(y)))\n",
    "    S = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=N_MELS, n_fft=N_FFT, hop_length=HOP)\n",
    "    S_db = librosa.power_to_db(S, ref=np.max)\n",
    "    S_db = (S_db - S_db.min()) / (S_db.max() - S_db.min() + 1e-8)\n",
    "    if S_db.shape[1] != FIXED_W:\n",
    "        from skimage.transform import resize\n",
    "        S_db = resize(S_db, (N_MELS, FIXED_W), anti_aliasing=True)\n",
    "    tensor = torch.tensor(S_db, dtype=torch.float32).unsqueeze(0).unsqueeze(0)  # (1,1,128,128)\n",
    "    return tensor, S_db\n",
    "\n",
    "print('Helper ready.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 5: Build SHAP background dataset ────────────────────────────────────\n",
    "meta = pd.read_csv(DATA / 'gtzan_metadata.csv')\n",
    "preds_df = pd.read_csv(DATA / 'test_predictions.csv')\n",
    "\n",
    "# Use 50 clips as background (stratified)\n",
    "bg_clips = []\n",
    "for genre in GENRES:\n",
    "    rows = meta[(meta.genre == genre) & (meta.fault == 'clean')].sample(\n",
    "        5, random_state=42, replace=True\n",
    "    )\n",
    "    for _, row in rows.iterrows():\n",
    "        try:\n",
    "            t, _ = load_spectrogram(row.filepath)\n",
    "            bg_clips.append(t)\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "background = torch.cat(bg_clips, dim=0).to(DEVICE)  # (50, 1, 128, 128)\n",
    "print(f'Background tensor: {background.shape}')\n",
    "\n",
    "# SHAP DeepExplainer\n",
    "explainer = shap.DeepExplainer(model, background)\n",
    "print('SHAP explainer initialised.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 6: Compute SHAP values for one correct clip per genre ────────────────\n",
    "# Select one correctly-classified clip per genre\n",
    "shap_results = {}\n",
    "\n",
    "for genre in tqdm(GENRES, desc='Computing SHAP'):\n",
    "    correct = preds_df[(preds_df.true_genre == genre) &\n",
    "                       (preds_df.pred_genre == genre) &\n",
    "                       (preds_df.fault == 'clean')]\n",
    "    if correct.empty:\n",
    "        print(f'  No correct clips for {genre}')\n",
    "        continue\n",
    "    row = correct.iloc[0]\n",
    "    try:\n",
    "        tensor, spec = load_spectrogram(row.filepath)\n",
    "        tensor_dev = tensor.to(DEVICE)\n",
    "        shap_vals = explainer.shap_values(tensor_dev)  # list of 10 arrays\n",
    "        genre_idx = le.transform([genre])[0]\n",
    "        shap_results[genre] = {\n",
    "            'shap': shap_vals[genre_idx][0, 0],  # (128, 128)\n",
    "            'spec': spec,\n",
    "            'filepath': row.filepath,\n",
    "            'filename': row.filename,\n",
    "        }\n",
    "    except Exception as e:\n",
    "        print(f'  Error for {genre}: {e}')\n",
    "\n",
    "with open(DATA / 'shap_values.pkl', 'wb') as f:\n",
    "    pickle.dump(shap_results, f)\n",
    "print(f'SHAP computed for {len(shap_results)} genres. Saved.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 7: Figure 11 — SHAP overlay gallery (one per genre) ──────────────────\n",
    "# Custom diverging colormap: negative=blue (suppresses), positive=red (drives)\n",
    "shap_cmap = LinearSegmentedColormap.from_list(\n",
    "    'shap_audio', ['#1565C0', '#BBDEFB', '#FFFFFF', '#FFCDD2', '#C62828']\n",
    ")\n",
    "\n",
    "genres_with_shap = [g for g in GENRES if g in shap_results]\n",
    "n = len(genres_with_shap)\n",
    "ncols = 5\n",
    "nrows = (n + ncols - 1) // ncols\n",
    "\n",
    "fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 4, nrows * 4))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, genre in enumerate(genres_with_shap):\n",
    "    ax = axes[i]\n",
    "    d  = shap_results[genre]\n",
    "    spec = d['spec']       # (128, 128)\n",
    "    sv   = d['shap']       # (128, 128)\n",
    "\n",
    "    # Background: mel spectrogram\n",
    "    ax.imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.85)\n",
    "\n",
    "    # Overlay: SHAP values\n",
    "    vmax = np.abs(sv).max()\n",
    "    im = ax.imshow(sv, aspect='auto', origin='lower',\n",
    "                   cmap=shap_cmap, alpha=0.7,\n",
    "                   vmin=-vmax, vmax=vmax)\n",
    "\n",
    "    ax.set_title(genre.capitalize(), fontweight='bold', fontsize=13)\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "\n",
    "# Hide unused axes\n",
    "for j in range(i + 1, len(axes)):\n",
    "    axes[j].set_visible(False)\n",
    "\n",
    "# Shared colorbar\n",
    "fig.colorbar(im, ax=axes[:n], orientation='vertical', fraction=0.015,\n",
    "             pad=0.02, label='SHAP value (negative → suppresses, positive → drives)')\n",
    "\n",
    "fig.suptitle(\n",
    "    'Figure 11 — SHAP Attribution Maps on Mel Spectrograms\\n'\n",
    "    '(Red = drives classification | Blue = suppresses)',\n",
    "    fontweight='bold'\n",
    ")\n",
    "savefig('03_shap_gallery', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 8: Figure 12 — Deep-dive: Blues vs Jazz SHAP side-by-side ────────────\n",
    "pair = ['blues', 'jazz']\n",
    "fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n",
    "\n",
    "titles_row = ['Mel Spectrogram', 'SHAP Attribution', 'Spectrogram + SHAP Overlay']\n",
    "\n",
    "for row_i, genre in enumerate(pair):\n",
    "    if genre not in shap_results:\n",
    "        continue\n",
    "    d    = shap_results[genre]\n",
    "    spec = d['spec']\n",
    "    sv   = d['shap']\n",
    "    vmax = np.abs(sv).max()\n",
    "\n",
    "    # Col 0: raw spectrogram\n",
    "    axes[row_i, 0].imshow(spec, aspect='auto', origin='lower', cmap='magma')\n",
    "    axes[row_i, 0].set_ylabel(genre.capitalize(), fontweight='bold', fontsize=14)\n",
    "\n",
    "    # Col 1: SHAP only\n",
    "    im1 = axes[row_i, 1].imshow(sv, aspect='auto', origin='lower',\n",
    "                                  cmap=shap_cmap, vmin=-vmax, vmax=vmax)\n",
    "\n",
    "    # Col 2: overlay\n",
    "    axes[row_i, 2].imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.8)\n",
    "    axes[row_i, 2].imshow(sv, aspect='auto', origin='lower',\n",
    "                           cmap=shap_cmap, alpha=0.65, vmin=-vmax, vmax=vmax)\n",
    "\n",
    "    # Frequency band annotations\n",
    "    for ax in axes[row_i]:\n",
    "        ax.axhline(20, color='yellow', linewidth=0.8, linestyle='--', alpha=0.7)   # ~Low rhythm band\n",
    "        ax.axhline(60, color='cyan',   linewidth=0.8, linestyle='--', alpha=0.7)   # ~Mid harmonic band\n",
    "        ax.axhline(100,color='lime',   linewidth=0.8, linestyle='--', alpha=0.7)   # ~High timbre band\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "\n",
    "    fig.colorbar(im1, ax=axes[row_i, 1], label='SHAP value', shrink=0.85)\n",
    "\n",
    "for j, title in enumerate(titles_row):\n",
    "    axes[0, j].set_title(title, fontweight='bold')\n",
    "\n",
    "# Legend for frequency bands\n",
    "from matplotlib.lines import Line2D\n",
    "legend_els = [\n",
    "    Line2D([0],[0], color='yellow', linestyle='--', label='Low-freq (rhythm ~250Hz)'),\n",
    "    Line2D([0],[0], color='cyan',   linestyle='--', label='Mid-freq (harmony ~1kHz)'),\n",
    "    Line2D([0],[0], color='lime',   linestyle='--', label='High-freq (timbre ~4kHz)'),\n",
    "]\n",
    "fig.legend(handles=legend_els, loc='lower center', ncol=3, fontsize=10,\n",
    "           bbox_to_anchor=(0.5, -0.02))\n",
    "\n",
    "fig.suptitle('Figure 12 — SHAP Deep-Dive: Blues vs Jazz Frequency Attribution', fontweight='bold')\n",
    "savefig('03_shap_blues_jazz', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 9: Figure 13 — Mean absolute SHAP per frequency band per genre ───────\n",
    "# Frequency bands in mel bin indices (approximate, SR=22050, N_MELS=128)\n",
    "bands = {\n",
    "    'Sub-bass (20–60Hz)':   (0,  10),\n",
    "    'Bass/Rhythm (60–250Hz)':(10, 30),\n",
    "    'Harmony (250Hz–2kHz)': (30, 80),\n",
    "    'Timbre/Air (2–8kHz)':  (80, 128),\n",
    "}\n",
    "\n",
    "band_data = []\n",
    "for genre in GENRES:\n",
    "    if genre not in shap_results:\n",
    "        continue\n",
    "    sv = np.abs(shap_results[genre]['shap'])  # (128, 128)\n",
    "    for band_name, (lo, hi) in bands.items():\n",
    "        band_data.append({\n",
    "            'genre': genre,\n",
    "            'band': band_name,\n",
    "            'mean_abs_shap': sv[lo:hi, :].mean()\n",
    "        })\n",
    "\n",
    "band_df = pd.DataFrame(band_data)\n",
    "pivot   = band_df.pivot(index='genre', columns='band', values='mean_abs_shap')\n",
    "pivot   = pivot.reindex(GENRES).dropna()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 7))\n",
    "x   = np.arange(len(pivot))\n",
    "w   = 0.2\n",
    "band_colors = ['#1A237E','#1565C0','#0288D1','#00ACC1']\n",
    "\n",
    "for i, (band, color) in enumerate(zip(pivot.columns, band_colors)):\n",
    "    ax.bar(x + i*w, pivot[band], w, label=band, color=color, alpha=0.85, edgecolor='white')\n",
    "\n",
    "ax.set_xticks(x + 1.5*w)\n",
    "ax.set_xticklabels([g.capitalize() for g in pivot.index], rotation=30, ha='right')\n",
    "ax.set_ylabel('Mean |SHAP|')\n",
    "ax.set_title('Figure 13 — Mean Absolute SHAP Attribution per Frequency Band per Genre', fontweight='bold')\n",
    "ax.legend(bbox_to_anchor=(1.01, 1), loc='upper left', fontsize=9)\n",
    "savefig('03_shap_frequency_bands', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 10: Figure 14 — SHAP on misclassified clips ─────────────────────────\n",
    "wrong = preds_df[(preds_df.correct == 0) & (preds_df.fault == 'clean')].head(6)\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, (_, row) in enumerate(wrong.iterrows()):\n",
    "    try:\n",
    "        tensor, spec = load_spectrogram(row.filepath)\n",
    "        sv_all = explainer.shap_values(tensor.to(DEVICE))\n",
    "        # Show SHAP for the *predicted* (wrong) class\n",
    "        pred_idx = le.transform([row.pred_genre])[0]\n",
    "        sv = sv_all[pred_idx][0, 0]\n",
    "\n",
    "        ax = axes[i]\n",
    "        ax.imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.8)\n",
    "        vmax = np.abs(sv).max()\n",
    "        ax.imshow(sv, aspect='auto', origin='lower',\n",
    "                  cmap=shap_cmap, alpha=0.65, vmin=-vmax, vmax=vmax)\n",
    "        ax.set_title(\n",
    "            f'True: {row.true_genre.capitalize()}\\nPredicted: {row.pred_genre.capitalize()}',\n",
    "            fontweight='bold', fontsize=11, color='#C62828'\n",
    "        )\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "    except Exception as e:\n",
    "        axes[i].set_visible(False)\n",
    "\n",
    "fig.suptitle(\n",
    "    'Figure 14 — SHAP on Misclassified Clips\\n'\n",
    "    '(Showing attribution toward predicted wrong class)',\n",
    "    fontweight='bold'\n",
    ")\n",
    "savefig('03_shap_misclassified', fig)"
   ]
  }
