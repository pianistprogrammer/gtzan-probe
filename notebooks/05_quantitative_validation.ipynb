    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# METRIC 4: Spurious Correlation Detection\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# Check: do models attend to silence/low-energy regions (recording artifacts)?\n",
    "\n",
    "spurious_rows = []\n",
    "for genre in GENRES:\n",
    "    if genre not in shap_results:\n",
    "        continue\n",
    "    spec = shap_results[genre]['spec']  # (128, 128) normalised [0,1]\n",
    "    sv   = shap_results[genre]['shap']\n",
    "\n",
    "    # Silence mask: regions with very low energy (bottom 10% of spec values)\n",
    "    silence_mask = spec < np.percentile(spec, 10)\n",
    "    high_e_mask  = spec > np.percentile(spec, 90)\n",
    "\n",
    "    # Mean |SHAP| in silence regions vs high-energy regions\n",
    "    shap_in_silence  = np.abs(sv)[silence_mask].mean()\n",
    "    shap_in_high_e   = np.abs(sv)[high_e_mask].mean()\n",
    "    ratio = shap_in_silence / (shap_in_high_e + 1e-8)\n",
    "\n",
    "    # Silence-attending ratio > 0.5 suggests spurious correlation\n",
    "    spurious_rows.append({\n",
    "        'genre': genre,\n",
    "        'shap_silence_mean':  round(shap_in_silence, 6),\n",
    "        'shap_high_e_mean':   round(shap_in_high_e, 6),\n",
    "        'silence_ratio':      round(ratio, 3),\n",
    "        'spurious_flag':      'Yes' if ratio > 0.5 else 'No'\n",
    "    })\n",
    "\n",
    "spurious_df = pd.DataFrame(spurious_rows)\n",
    "spurious_df.to_csv(DATA / 'spurious_correlation.csv', index=False)\n",
    "print('Spurious Correlation Analysis:')\n",
    "print(spurious_df.to_string(index=False))"
   ]
