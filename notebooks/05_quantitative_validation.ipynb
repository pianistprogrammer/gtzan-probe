   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# METRIC 2: Faithfulness — Top-K SHAP removal test\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "def load_spectrogram(filepath, start_s=0.0):\n",
    "    y, _ = librosa.load(filepath, sr=SR, offset=start_s, duration=SEG_S)\n",
    "    if len(y) < int(SEG_S * SR):\n",
    "        y = np.pad(y, (0, int(SEG_S * SR) - len(y)))\n",
    "    S    = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=N_MELS, n_fft=N_FFT, hop_length=HOP)\n",
    "    S_db = librosa.power_to_db(S, ref=np.max)\n",
    "    S_db = (S_db - S_db.min()) / (S_db.max() - S_db.min() + 1e-8)\n",
    "    if S_db.shape[1] != FIXED_W:\n",
    "        from skimage.transform import resize\n",
    "        S_db = resize(S_db, (N_MELS, FIXED_W), anti_aliasing=True)\n",
    "    return S_db\n",
    "\n",
    "def predict_from_spec(spec_np):\n",
    "    \"\"\"Run model inference on numpy spectrogram.\"\"\"\n",
    "    t = torch.tensor(spec_np, dtype=torch.float32).unsqueeze(0).unsqueeze(0).to(DEVICE)\n",
    "    with torch.no_grad():\n",
    "        logits = model(t)\n",
    "        return logits.argmax(1).item()\n",
    "\n",
    "K_VALUES = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]\n",
    "faithfulness_rows = []\n",
    "\n",
    "for genre in tqdm(GENRES, desc='Faithfulness test'):\n",
    "    if genre not in shap_results:\n",
    "        continue\n",
    "    d    = shap_results[genre]\n",
    "    sv   = d['shap']          # (128, 128)\n",
    "    spec = d['spec']          # (128, 128)\n",
    "    fp   = d['filepath']\n",
    "    genre_idx = le.transform([genre])[0]\n",
    "\n",
    "    flat_sv = sv.flatten()\n",
    "    sorted_idx = np.argsort(flat_sv)[::-1]  # descending importance\n",
    "\n",
    "    # Baseline confidence\n",
    "    t    = torch.tensor(spec, dtype=torch.float32).unsqueeze(0).unsqueeze(0).to(DEVICE)\n",
    "    with torch.no_grad():\n",
    "        base_probs = F.softmax(model(t), dim=-1)[0].cpu().numpy()\n",
    "    base_conf = base_probs[genre_idx]\n",
    "\n",
    "    for k in K_VALUES:\n",
    "        n_mask = int(k * len(flat_sv))\n",
    "        masked  = spec.copy()\n",
    "        mask_indices = np.unravel_index(sorted_idx[:n_mask], spec.shape)\n",
    "        masked[mask_indices] = 0.0  # zero out top-K SHAP pixels\n",
    "\n",
    "        t2 = torch.tensor(masked, dtype=torch.float32).unsqueeze(0).unsqueeze(0).to(DEVICE)\n",
    "        with torch.no_grad():\n",
    "            probs_masked = F.softmax(model(t2), dim=-1)[0].cpu().numpy()\n",
    "        masked_conf = probs_masked[genre_idx]\n",
    "\n",
    "        faithfulness_rows.append({\n",
    "            'genre':        genre,\n",
    "            'k':            k,\n",
    "            'base_conf':    base_conf,\n",
    "            'masked_conf':  masked_conf,\n",
    "            'conf_drop':    base_conf - masked_conf,\n",
    "            'pct_drop':     (base_conf - masked_conf) / (base_conf + 1e-8) * 100\n",
    "        })\n",
    "\n",
    "faith_df = pd.DataFrame(faithfulness_rows)\n",
    "faith_df.to_csv(DATA / 'faithfulness_results.csv', index=False)\n",
    "print('Faithfulness test complete.')\n",
    "faith_df.groupby('k')['conf_drop'].mean()"
   ]
  },
