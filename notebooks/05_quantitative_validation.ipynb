    "for bar, rho in zip(bars, alignment_df['spearman_rho']):\n",
    "    axes[2].text(rho + 0.03, bar.get_y() + bar.get_height()/2,\n",
    "                 f'{rho:.2f}', va='center', fontsize=9)\n",
    "\n",
    "fig.suptitle('Figure 18 — Musicological Alignment: Model Attribution vs Ground Truth',\n",
    "             fontweight='bold')\n",
    "savefig('05_musicological_alignment', fig)"
   ]
