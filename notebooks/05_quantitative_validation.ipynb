    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# METRIC 1: Musicological Alignment Score\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "# Ground truth: which frequency bands SHOULD drive each genre\n",
    "# Based on music theory literature\n",
    "# Mel bin ranges: 0-10=sub-bass, 10-30=bass/rhythm, 30-80=harmony, 80-128=timbre\n",
    "GT_BANDS = {\n",
    "    'blues':     {'bass/rhythm': 1.0, 'harmony': 0.7, 'timbre': 0.4, 'sub-bass': 0.3},\n",
    "    'classical': {'harmony': 1.0, 'timbre': 0.9, 'sub-bass': 0.2, 'bass/rhythm': 0.3},\n",
    "    'country':   {'bass/rhythm': 0.8, 'harmony': 0.9, 'timbre': 0.6, 'sub-bass': 0.2},\n",
    "    'disco':     {'bass/rhythm': 1.0, 'sub-bass': 0.8, 'harmony': 0.5, 'timbre': 0.4},\n",
    "    'hiphop':    {'sub-bass': 1.0, 'bass/rhythm': 0.9, 'harmony': 0.3, 'timbre': 0.3},\n",
    "    'jazz':      {'harmony': 1.0, 'bass/rhythm': 0.8, 'timbre': 0.7, 'sub-bass': 0.2},\n",
    "    'metal':     {'timbre': 1.0, 'bass/rhythm': 0.9, 'harmony': 0.6, 'sub-bass': 0.5},\n",
    "    'pop':       {'bass/rhythm': 0.8, 'harmony': 0.8, 'timbre': 0.6, 'sub-bass': 0.4},\n",
    "    'reggae':    {'sub-bass': 1.0, 'bass/rhythm': 0.9, 'harmony': 0.4, 'timbre': 0.3},\n",
    "    'rock':      {'bass/rhythm': 1.0, 'timbre': 0.9, 'harmony': 0.5, 'sub-bass': 0.4},\n",
    "}\n",
    "\n",
    "BAND_RANGES = {\n",
    "    'sub-bass':   (0,  10),\n",
    "    'bass/rhythm':(10, 30),\n",
    "    'harmony':    (30, 80),\n",
    "    'timbre':     (80, 128),\n",
    "}\n",
    "\n",
    "def musicological_alignment(abs_shap, genre_gt):\n",
    "    \"\"\"\n",
    "    Compute Spearman correlation between:\n",
    "    - model's |SHAP| attribution per band\n",
    "    - musicological ground truth weights\n",
    "    \"\"\"\n",
    "    model_weights, gt_weights = [], []\n",
    "    for band, (lo, hi) in BAND_RANGES.items():\n",
    "        model_weights.append(abs_shap[lo:hi].mean())\n",
    "        gt_weights.append(genre_gt.get(band, 0.0))\n",
    "    rho, p = stats.spearmanr(model_weights, gt_weights)\n",
    "    return rho, p, model_weights, gt_weights\n",
    "\n",
    "alignment_rows = []\n",
    "for genre in GENRES:\n",
    "    if genre not in shap_results:\n",
    "        continue\n",
    "    sv   = np.abs(shap_results[genre]['shap'])\n",
    "    gt   = GT_BANDS[genre]\n",
    "    rho, p, mw, gw = musicological_alignment(sv, gt)\n",
    "    alignment_rows.append({\n",
    "        'genre': genre,\n",
    "        'spearman_rho': round(rho, 3),\n",
    "        'p_value': round(p, 4),\n",
    "        'aligned': 'Yes' if rho > 0.5 else 'Partial' if rho > 0 else 'No',\n",
    "        'model_sub-bass': round(mw[0], 5),\n",
    "        'model_bass/rhythm': round(mw[1], 5),\n",
    "        'model_harmony': round(mw[2], 5),\n",
    "        'model_timbre': round(mw[3], 5),\n",
    "        'gt_sub-bass': gw[0],\n",
    "        'gt_bass/rhythm': gw[1],\n",
    "        'gt_harmony': gw[2],\n",
    "        'gt_timbre': gw[3],\n",
    "    })\n",
    "\n",
    "alignment_df = pd.DataFrame(alignment_rows)\n",
    "alignment_df.to_csv(DATA / 'musicological_alignment.csv', index=False)\n",
    "print('Musicological Alignment Scores:')\n",
    "print(alignment_df[['genre','spearman_rho','p_value','aligned']].to_string(index=False))"
   ]
  },
