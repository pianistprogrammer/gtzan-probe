   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# METRIC 3: Inter-method agreement (SHAP vs LIME)\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "agreement_rows = []\n",
    "for genre in GENRES:\n",
    "    if genre not in shap_results or genre not in lime_results:\n",
    "        continue\n",
    "    sv   = np.abs(shap_results[genre]['shap']).flatten()\n",
    "    lv   = np.abs(lime_results[genre]['importance_map']).flatten()\n",
    "\n",
    "    # Normalise both to [0,1]\n",
    "    sv_n = sv / (sv.max() + 1e-8)\n",
    "    lv_n = lv / (lv.max() + 1e-8)\n",
    "\n",
    "    pearson_r, pearson_p = stats.pearsonr(sv_n, lv_n)\n",
    "    spearman_r, spear_p  = stats.spearmanr(sv_n, lv_n)\n",
    "\n",
    "    # Top-K agreement: do both methods agree on the most important 10% of pixels?\n",
    "    k = int(0.1 * len(sv_n))\n",
    "    top_shap = set(np.argsort(sv_n)[-k:])\n",
    "    top_lime = set(np.argsort(lv_n)[-k:])\n",
    "    iou = len(top_shap & top_lime) / len(top_shap | top_lime)\n",
    "\n",
    "    agreement_rows.append({\n",
    "        'genre': genre,\n",
    "        'pearson_r': round(pearson_r, 3),\n",
    "        'spearman_r': round(spearman_r, 3),\n",
    "        'top10_iou': round(iou, 3),\n",
    "    })\n",
    "\n",
    "agree_df = pd.DataFrame(agreement_rows)\n",
    "agree_df.to_csv(DATA / 'method_agreement.csv', index=False)\n",
    "print('\\nInter-method Agreement (SHAP vs LIME):')\n",
    "print(agree_df.to_string(index=False))\n",
    "print(f'\\nMean Pearson r: {agree_df.pearson_r.mean():.3f}')\n",
