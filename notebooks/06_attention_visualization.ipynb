    "# Notebook 06 — Attention Visualization (Audio Spectrogram Transformer)\n",
    "### XAI for Music Genre Classification | GTZAN Dataset\n",
    "---\n",
    "**Purpose:** Fine-tune a pretrained Audio Spectrogram Transformer (AST) on GTZAN and visualise multi-head attention weights to compare with SHAP/LIME explanations from Notebooks 03–04.\n",
    "\n",
    "**Key contribution:** Attention maps provide a third XAI lens. Comparing attention vs SHAP vs LIME reveals which explanation method is most musicologically faithful.\n",
    "\n",
    "**Model:** `MIT/ast-finetuned-audioset-10-10-0.4593` from HuggingFace (fine-tuned on AudioSet, adapted to GTZAN genres)\n",
    "\n",
    "**Note:** Attention ≠ causation — we explicitly discuss this limitation in the paper."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, sys\n",
    "for pkg in ['transformers', 'torch', 'librosa', 'numpy', 'pandas',\n",
    "            'matplotlib', 'seaborn', 'tqdm', 'scikit-learn', 'datasets']:\n",
    "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', pkg])\n",
    "print('Done.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pickle, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from transformers import ASTFeatureExtractor, ASTForAudioClassification\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "from sklearn.metrics import classification_report\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 300, 'savefig.dpi': 300,\n",
    "    'font.family': 'DejaVu Sans', 'font.size': 12,\n",
    "    'axes.titlesize': 13, 'axes.labelsize': 12,\n",
    "    'axes.spines.top': False, 'axes.spines.right': False,\n",
    "})\n",
    "\n",
    "FIGURES = Path('../figures')\n",
    "MODELS  = Path('../models')\n",
    "DATA    = Path('../data')\n",
    "\n",
    "DEVICE = ('mps' if torch.backends.mps.is_available() else\n",
    "          'cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {DEVICE}')\n",
    "\n",
    "GENRES = ['blues','classical','country','disco','hiphop',\n",
    "          'jazz','metal','pop','reggae','rock']\n",
    "\n",
    "SR = 16000  # AST expects 16kHz\n",
    "\n",
    "def savefig(name, fig=None):\n",
    "    if fig is None: fig = plt.gcf()\n",
    "    path = FIGURES / f'{name}.png'\n",
    "    fig.savefig(path, dpi=300, bbox_inches='tight', facecolor='white')\n",
    "    print(f'  ✓ Saved {path}')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Load AST model & feature extractor ───────────────────────────────────────\n",
    "AST_MODEL_ID = 'MIT/ast-finetuned-audioset-10-10-0.4593'\n",
    "\n",
    "feature_extractor = ASTFeatureExtractor.from_pretrained(AST_MODEL_ID)\n",
    "ast_model = ASTForAudioClassification.from_pretrained(\n",
    "    AST_MODEL_ID,\n",
    "    num_labels=10,\n",
    "    ignore_mismatched_sizes=True,  # replace classification head\n",
    "    output_attentions=True,\n",
    ")\n",
    "\n",
    "# Re-init classification head for 10 genres\n",
    "hidden_size = ast_model.config.hidden_size\n",
    "ast_model.classifier = nn.Sequential(\n",
    "    nn.LayerNorm(hidden_size),\n",
    "    nn.Linear(hidden_size, 10)\n",
    ")\n",
    "\n",
    "ast_model = ast_model.to(DEVICE)\n",
    "print(f'AST model loaded. Hidden size: {hidden_size}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Dataset for AST ───────────────────────────────────────────────────────────\n",
    "class GTZANAudioDataset(Dataset):\n",
    "    def __init__(self, meta_df, label_encoder, feature_extractor, duration=10.0, augment=False):\n",
    "        self.records  = meta_df.reset_index(drop=True)\n",
    "        self.le       = label_encoder\n",
    "        self.fe       = feature_extractor\n",
    "        self.duration = duration\n",
    "        self.augment  = augment\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.records)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row   = self.records.iloc[idx]\n",
    "        label = self.le.transform([row.genre])[0]\n",
    "        try:\n",
    "            y, _ = librosa.load(row.filepath, sr=SR, duration=self.duration)\n",
    "        except Exception:\n",
    "            y = np.zeros(int(SR * self.duration))\n",
    "\n",
    "        expected = int(SR * self.duration)\n",
    "        if len(y) < expected:\n",
    "            y = np.pad(y, (0, expected - len(y)))\n",
    "        else:\n",
    "            if self.augment:\n",
    "                start = np.random.randint(0, len(y) - expected + 1)\n",
    "                y = y[start:start + expected]\n",
    "            else:\n",
    "                y = y[:expected]\n",
    "\n",
    "        inputs = self.fe(y, sampling_rate=SR, return_tensors='pt')\n",
    "        return inputs['input_values'].squeeze(0), label, row.filename\n",
    "\n",
    "print('GTZANAudioDataset defined.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Build dataloaders & fine-tune AST ─────────────────────────────────────────\n",
    "meta      = pd.read_csv(DATA / 'gtzan_metadata.csv')\n",
    "clean_meta = meta[meta.fault == 'clean']\n",
    "\n",
    "le = LabelEncoder()\n",
    "le.fit(GENRES)\n",
    "\n",
    "from sklearn.model_selection import StratifiedShuffleSplit\n",
    "sss = StratifiedShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n",
    "for train_idx, test_idx in sss.split(clean_meta, clean_meta['genre']):\n",
    "    train_meta = clean_meta.iloc[train_idx]\n",
    "    test_meta  = clean_meta.iloc[test_idx]\n",
    "\n",
    "train_ds_ast = GTZANAudioDataset(train_meta, le, feature_extractor, augment=True)\n",
    "test_ds_ast  = GTZANAudioDataset(test_meta,  le, feature_extractor, augment=False)\n",
    "\n",
    "train_loader_ast = DataLoader(train_ds_ast, batch_size=8, shuffle=True,  num_workers=0)\n",
    "test_loader_ast  = DataLoader(test_ds_ast,  batch_size=8, shuffle=False, num_workers=0)\n",
    "\n",
    "print(f'Train: {len(train_ds_ast)} | Test: {len(test_ds_ast)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Fine-tune AST (linear probing first, then full fine-tune) ─────────────────\n",
    "# Phase 1: freeze backbone, train head only (10 epochs)\n",
    "for name, p in ast_model.named_parameters():\n",
    "    if 'classifier' not in name:\n",
    "        p.requires_grad = False\n",
    "\n",
    "optimizer = optim.AdamW(filter(lambda p: p.requires_grad, ast_model.parameters()), lr=1e-3)\n",
    "criterion = nn.CrossEntropyLoss(label_smoothing=0.1)\n",
    "\n",
    "ast_history = {'train_acc': [], 'val_acc': []}\n",
    "\n",
    "def run_epoch(loader, train=True):\n",
    "    ast_model.train(train)\n",
    "    correct, total, total_loss = 0, 0, 0.0\n",
    "    for X, y, _ in loader:\n",
    "        X, y = X.to(DEVICE), y.to(DEVICE)\n",
    "        with torch.set_grad_enabled(train):\n",
    "            out   = ast_model(X)\n",
    "            logits = out.logits\n",
    "            loss   = criterion(logits, y)\n",
    "            if train:\n",
    "                optimizer.zero_grad()\n",
    "                loss.backward()\n",
    "                optimizer.step()\n",
    "        correct    += (logits.argmax(1) == y).sum().item()\n",
    "        total      += len(y)\n",
    "        total_loss += loss.item() * len(y)\n",
    "    return total_loss / total, correct / total\n",
    "\n",
    "print('Phase 1: Linear probing (10 epochs)...')\n",
    "for epoch in range(1, 11):\n",
    "    t_loss, t_acc = run_epoch(train_loader_ast, train=True)\n",
    "    v_loss, v_acc = run_epoch(test_loader_ast,  train=False)\n",
    "    ast_history['train_acc'].append(t_acc)\n",
    "    ast_history['val_acc'].append(v_acc)\n",
    "    if epoch % 5 == 0:\n",
    "        print(f'  Ep {epoch:02d} | train_acc={t_acc:.3f} | val_acc={v_acc:.3f}')\n",
    "\n",
    "# Phase 2: unfreeze all, fine-tune with small LR (10 more epochs)\n",
    "print('\\nPhase 2: Full fine-tuning (10 epochs)...')\n",
    "for p in ast_model.parameters():\n",
    "    p.requires_grad = True\n",
    "optimizer = optim.AdamW(ast_model.parameters(), lr=1e-5, weight_decay=1e-4)\n",
    "scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=10, eta_min=1e-6)\n",
    "\n",
    "best_ast_acc = 0.0\n",
    "for epoch in range(1, 11):\n",
    "    t_loss, t_acc = run_epoch(train_loader_ast, train=True)\n",
    "    v_loss, v_acc = run_epoch(test_loader_ast,  train=False)\n",
    "    ast_history['train_acc'].append(t_acc)\n",
    "    ast_history['val_acc'].append(v_acc)\n",
    "    scheduler.step()\n",
    "    if v_acc > best_ast_acc:\n",
    "        best_ast_acc = v_acc\n",
    "        torch.save(ast_model.state_dict(), MODELS / 'ast_gtzan_best.pt')\n",
    "    if epoch % 5 == 0:\n",
    "        print(f'  Ep {epoch:02d} | train_acc={t_acc:.3f} | val_acc={v_acc:.3f}')\n",
    "\n",
    "print(f'\\nBest AST val accuracy: {best_ast_acc:.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 23 — AST Training Curves ──────────────────────────────────────────\n",
    "fig, ax = plt.subplots(figsize=(14, 5))\n",
    "epochs_range = range(1, len(ast_history['train_acc']) + 1)\n",
    "ax.plot(epochs_range, [a*100 for a in ast_history['train_acc']], 'b-', linewidth=2, label='Train acc')\n",
    "ax.plot(epochs_range, [a*100 for a in ast_history['val_acc']],   'r--', linewidth=2, label='Val acc')\n",
    "ax.axvline(10.5, color='gray', linestyle=':', linewidth=1.2, label='Phase 1→2 boundary')\n",
    "ax.set_xlabel('Epoch')\n",
    "ax.set_ylabel('Accuracy (%)')\n",
    "ax.set_title('Figure 23 — AST Fine-tuning: Linear Probing (Phase 1) → Full Fine-tune (Phase 2)', fontweight='bold')\n",
    "ax.legend()\n",
    "savefig('06_ast_training', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Extract & visualise attention maps ───────────────────────────────────────\n",
    "ast_model.load_state_dict(torch.load(MODELS / 'ast_gtzan_best.pt', map_location=DEVICE))\n",
    "ast_model.eval()\n",
    "\n",
    "attention_results = {}\n",
    "\n",
    "for genre in tqdm(GENRES, desc='Extracting attention'):\n",
    "    clips = meta[(meta.genre == genre) & (meta.fault == 'clean')].head(1)\n",
    "    if clips.empty:\n",
    "        continue\n",
    "    fp = clips.iloc[0]['filepath']\n",
    "    try:\n",
    "        y, _ = librosa.load(fp, sr=SR, duration=10.0)\n",
    "        if len(y) < SR * 10:\n",
    "            y = np.pad(y, (0, SR*10 - len(y)))\n",
    "        inputs = feature_extractor(y, sampling_rate=SR, return_tensors='pt')\n",
    "        X = inputs['input_values'].to(DEVICE)\n",
    "\n",
    "        with torch.no_grad():\n",
    "            out = ast_model(X, output_attentions=True)\n",
    "\n",
    "        # Shape: (n_layers, 1, n_heads, seq_len, seq_len)\n",
    "        # Average over all layers and heads → (seq_len, seq_len)\n",
    "        attn_all = torch.stack(out.attentions)  # (n_layers, 1, n_heads, T, T)\n",
    "        attn_mean = attn_all.mean(dim=[0,1,2])   # (T, T)\n",
    "        # CLS token attention to all other tokens\n",
    "        cls_attn = attn_mean[0, 1:].cpu().numpy()  # (T-1,)\n",
    "\n",
    "        # Also get per-head attentions from last layer\n",
    "        last_layer_attn = out.attentions[-1][0, :, 0, 1:]  # (n_heads, T-1)\n",
    "\n",
    "        attention_results[genre] = {\n",
    "            'cls_attn': cls_attn,\n",
    "            'last_head_attn': last_layer_attn.cpu().numpy(),\n",
    "            'filepath': fp,\n",
    "            'pred': out.logits.argmax(1).item()\n",
    "        }\n",
    "    except Exception as e:\n",
    "        print(f'  Error {genre}: {e}')\n",
    "\n",
    "with open(DATA / 'attention_results.pkl', 'wb') as f:\n",
    "    pickle.dump(attention_results, f)\n",
    "print(f'Attention extracted for {len(attention_results)} genres.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 24 — CLS Attention gallery ─────────────────────────────────────────\n",
    "genres_ok = [g for g in GENRES if g in attention_results]\n",
    "fig, axes = plt.subplots(2, 5, figsize=(20, 7))\n",
    "axes = axes.flatten()\n",
    "\n",
    "GENRE_COLORS = dict(zip(GENRES, [\n",
    "    '#2196F3','#F44336','#4CAF50','#FF9800','#9C27B0',\n",
    "    '#00BCD4','#E91E63','#8BC34A','#FF5722','#607D8B'\n",
    "]))\n",
    "\n",
    "for i, genre in enumerate(genres_ok):\n",
    "    ca = attention_results[genre]['cls_attn']  # (T-1,)\n",
    "    pred_idx = attention_results[genre]['pred']\n",
    "    pred_genre = le.inverse_transform([pred_idx])[0]\n",
    "\n",
    "    # Try to reshape to 2D patch grid (AST patch grid depends on config)\n",
    "    T = len(ca)\n",
    "    h = int(np.sqrt(T))\n",
    "    w = T // h\n",
    "    ca_2d = ca[:h*w].reshape(h, w)\n",
    "\n",
    "    ax = axes[i]\n",
    "    im = ax.imshow(ca_2d, aspect='auto', origin='lower', cmap='hot')\n",
    "    correct = genre == pred_genre\n",
    "    title_color = '#1B5E20' if correct else '#B71C1C'\n",
    "    ax.set_title(\n",
    "        f'{genre.capitalize()}\\n→ {pred_genre.capitalize()}',\n",
    "        fontweight='bold', color=title_color, fontsize=10\n",
    "    )\n",
    "    ax.set_xticks([]); ax.set_yticks([])\n",
    "\n",
    "for j in range(i+1, len(axes)):\n",
    "    axes[j].set_visible(False)\n",
    "\n",
    "fig.colorbar(im, ax=axes[:len(genres_ok)], orientation='vertical',\n",
    "             fraction=0.015, pad=0.02, label='CLS token attention weight')\n",
    "\n",
    "fig.suptitle(\n",
    "    'Figure 24 — AST CLS Token Attention Maps per Genre\\n'\n",
    "    '(Green title = correct | Red title = misclassified)',\n",
    "    fontweight='bold'\n",
    ")\n",
    "savefig('06_attention_gallery', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 25 — Per-head attention diversity (last layer) ─────────────────────\n",
    "# Shows that different heads attend to different temporal regions\n",
    "genre_focus = 'jazz'\n",
    "if genre_focus in attention_results:\n",
    "    head_attn = attention_results[genre_focus]['last_head_attn']  # (n_heads, T-1)\n",
    "    n_heads   = head_attn.shape[0]\n",
    "    cols = 4\n",
    "    rows = (n_heads + cols - 1) // cols\n",
    "\n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(cols*4, rows*3))\n",
    "    axes = axes.flatten()\n",
    "\n",
    "    for h_i in range(n_heads):\n",
    "        ha  = head_attn[h_i]  # (T-1,)\n",
    "        T   = len(ha)\n",
    "        hh  = int(np.sqrt(T))\n",
    "        ww  = T // hh\n",
    "        ha_2d = ha[:hh*ww].reshape(hh, ww)\n",
    "        axes[h_i].imshow(ha_2d, aspect='auto', origin='lower', cmap='Blues')\n",
    "        axes[h_i].set_title(f'Head {h_i+1}', fontsize=9)\n",
    "        axes[h_i].set_xticks([]); axes[h_i].set_yticks([])\n",
    "\n",
    "    for j in range(n_heads, len(axes)):\n",
    "        axes[j].set_visible(False)\n",
    "\n",
    "    fig.suptitle(\n",
    "        f'Figure 25 — Per-Head Attention (Last Layer) — {genre_focus.capitalize()}\\n'\n",
    "        'Each head specialises in different spectro-temporal regions',\n",
    "        fontweight='bold'\n",
    "    )\n",
    "    savefig('06_per_head_attention', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 26 — Three-way comparison: SHAP vs LIME vs Attention ───────────────\n",
    "with open(DATA / 'shap_values.pkl', 'rb') as f:\n",
    "    shap_results = pickle.load(f)\n",
    "with open(DATA / 'lime_results.pkl', 'rb') as f:\n",
    "    lime_results = pickle.load(f)\n",
    "\n",
    "compare_genre = 'jazz'\n",
    "\n",
    "if all(compare_genre in d for d in [shap_results, lime_results, attention_results]):\n",
    "    fig, axes = plt.subplots(1, 4, figsize=(20, 5))\n",
    "\n",
    "    # Col 0: Raw spectrogram\n",
    "    spec = shap_results[compare_genre]['spec']\n",
    "    axes[0].imshow(spec, aspect='auto', origin='lower', cmap='magma')\n",
    "    axes[0].set_title('Mel Spectrogram', fontweight='bold')\n",
    "\n",
    "    # Col 1: SHAP\n",
    "    sv = shap_results[compare_genre]['shap']\n",
    "    vmax = np.abs(sv).max()\n",
    "    shap_cmap_local = LinearSegmentedColormap.from_list('', ['#1565C0','#fff','#C62828'])\n",
    "    axes[1].imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.7)\n",
    "    axes[1].imshow(sv, aspect='auto', origin='lower', cmap=shap_cmap_local, alpha=0.65, vmin=-vmax, vmax=vmax)\n",
    "    axes[1].set_title('SHAP Attribution', fontweight='bold')\n",
    "\n",
    "    # Col 2: LIME\n",
    "    imp = lime_results[compare_genre]['importance_map']\n",
    "    vmax2 = np.abs(imp).max()\n",
    "    axes[2].imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.7)\n",
    "    axes[2].imshow(imp, aspect='auto', origin='lower', cmap=shap_cmap_local, alpha=0.65, vmin=-vmax2, vmax=vmax2)\n",
    "    axes[2].set_title('LIME Attribution', fontweight='bold')\n",
    "\n",
    "    # Col 3: Attention (resized to match spectrogram)\n",
    "    ca = attention_results[compare_genre]['cls_attn']\n",
    "    T  = len(ca)\n",
    "    hh = int(np.sqrt(T)); ww = T // hh\n",
    "    ca_2d = ca[:hh*ww].reshape(hh, ww)\n",
    "    from skimage.transform import resize as sk_resize\n",
    "    ca_resized = sk_resize(ca_2d, spec.shape, anti_aliasing=True)\n",
    "    axes[3].imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.7)\n",
    "    axes[3].imshow(ca_resized, aspect='auto', origin='lower', cmap='hot', alpha=0.65)\n",
    "    axes[3].set_title('AST Attention', fontweight='bold')\n",
    "\n",
    "    for ax in axes:\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "\n",
    "    fig.suptitle(\n",
    "        f'Figure 26 — Three-Way XAI Comparison: {compare_genre.capitalize()}\\n'\n",
    "        'SHAP | LIME | Attention — do they agree?',\n",
    "        fontweight='bold'\n",
    "    )\n",
    "    savefig('06_three_way_comparison', fig)"
   ]
  }
