   "source": [
    "# Notebook 07 — Final Publication Figures & Results Compilation\n",
    "### XAI for Music Genre Classification | GTZAN Dataset\n",
    "---\n",
    "**Purpose:** Compile all results from Notebooks 01–06 into final publication-quality figures and tables formatted for ISMIR/ICASSP paper submission.\n",
    "\n",
    "**Outputs:**\n",
    "- `../figures/FINAL_*.png` — camera-ready figures (300 DPI, IEEE/ISMIR column widths)\n",
    "- `../data/paper_results.tex` — LaTeX table for direct paper insertion\n",
    "- `../data/paper_results_summary.md` — Markdown results summary\n",
    "\n",
    "**Paper section mapping:**\n",
    "- Fig 1 → Introduction/Related Work (GTZAN overview)\n",
    "- Fig 2 → Method (architecture)\n",
    "- Fig 3 → Results (SHAP main figure)\n",
    "- Fig 4 → Results (quantitative metrics)\n",
    "- Table 1 → Results (alignment + faithfulness)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pickle, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "from matplotlib.patches import FancyArrowPatch\n",
    "import matplotlib.patches as mpatches\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ── IEEE two-column = 3.5\" per col; single col = 7.25\" ────────────────────────\n",
    "IEEE_SINGLE = 7.25\n",
    "IEEE_DOUBLE = 3.5\n",
    "ISMIR_FULL  = 16.0   # ISMIR uses wider layout\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 300, 'savefig.dpi': 300,\n",
    "    'font.family': 'DejaVu Sans',\n",
    "    'font.size': 10,\n",
    "    'axes.titlesize': 11,\n",
    "    'axes.labelsize': 10,\n",
    "    'xtick.labelsize': 9,\n",
    "    'ytick.labelsize': 9,\n",
    "    'legend.fontsize': 9,\n",
    "    'figure.titlesize': 12,\n",
    "    'axes.spines.top': False,\n",
    "    'axes.spines.right': False,\n",
    "    'axes.grid': True,\n",
    "    'grid.alpha': 0.25,\n",
    "})\n",
    "\n",
    "FIGURES = Path('../figures')\n",
    "DATA    = Path('../data')\n",
    "\n",
    "GENRES = ['blues','classical','country','disco','hiphop',\n",
    "          'jazz','metal','pop','reggae','rock']\n",
    "\n",
    "GENRE_COLORS = dict(zip(GENRES, [\n",
    "    '#2196F3','#F44336','#4CAF50','#FF9800','#9C27B0',\n",
    "    '#00BCD4','#E91E63','#8BC34A','#FF5722','#607D8B'\n",
    "]))\n",
    "\n",
    "shap_cmap = LinearSegmentedColormap.from_list(\n",
    "    'shap_audio', ['#1565C0','#BBDEFB','#FFFFFF','#FFCDD2','#C62828']\n",
    ")\n",
    "\n",
    "def savefig_paper(name, fig=None, width_in=ISMIR_FULL, height_in=None):\n",
    "    if fig is None: fig = plt.gcf()\n",
    "    if height_in:\n",
    "        fig.set_size_inches(width_in, height_in)\n",
    "    fig.tight_layout()\n",
    "    path = FIGURES / f'FINAL_{name}.png'\n",
    "    fig.savefig(path, dpi=300, bbox_inches='tight', facecolor='white')\n",
    "    print(f'  ✓ Paper figure saved: {path}')\n",
    "    plt.show()\n",
    "\n",
    "print('Paper figure config loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Load all result files ─────────────────────────────────────────────────────\n",
    "with open(DATA / 'shap_values.pkl', 'rb') as f:\n",
    "    shap_results = pickle.load(f)\n",
    "\n",
    "with open(DATA / 'lime_results.pkl', 'rb') as f:\n",
    "    lime_results = pickle.load(f)\n",
    "\n",
    "alignment_df  = pd.read_csv(DATA / 'musicological_alignment.csv')\n",
    "faith_df      = pd.read_csv(DATA / 'faithfulness_results.csv')\n",
    "agree_df      = pd.read_csv(DATA / 'method_agreement.csv')\n",
    "spurious_df   = pd.read_csv(DATA / 'spurious_correlation.csv')\n",
    "summary_df    = pd.read_csv(DATA / 'xai_summary_table.csv')\n",
    "\n",
    "print('All result CSVs loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# FINAL FIGURE 1 — Main SHAP result (paper hero figure)\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "genres_show = ['blues', 'jazz', 'hiphop', 'classical', 'metal', 'reggae']\n",
    "genres_ok   = [g for g in genres_show if g in shap_results]\n",
    "\n",
    "fig = plt.figure(figsize=(ISMIR_FULL, 8))\n",
    "gs  = gridspec.GridSpec(2, len(genres_ok), figure=fig,\n",
    "                         hspace=0.05, wspace=0.05)\n",
    "\n",
    "for col, genre in enumerate(genres_ok):\n",
    "    spec = shap_results[genre]['spec']\n",
    "    sv   = shap_results[genre]['shap']\n",
    "    vmax = np.abs(sv).max()\n",
    "\n",
    "    # Row 0: Mel spectrogram\n",
    "    ax_spec = fig.add_subplot(gs[0, col])\n",
    "    ax_spec.imshow(spec, aspect='auto', origin='lower', cmap='magma')\n",
    "    ax_spec.set_xticks([]); ax_spec.set_yticks([])\n",
    "    if col == 0:\n",
    "        ax_spec.set_ylabel('Mel Spectrogram', fontsize=9, fontweight='bold')\n",
    "    ax_spec.set_title(genre.capitalize(), fontweight='bold',\n",
    "                      color=GENRE_COLORS[genre], fontsize=11)\n",
    "\n",
    "    # Row 1: SHAP overlay\n",
    "    ax_shap = fig.add_subplot(gs[1, col])\n",
    "    ax_shap.imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.75)\n",
    "    im = ax_shap.imshow(sv, aspect='auto', origin='lower',\n",
    "                         cmap=shap_cmap, alpha=0.70, vmin=-vmax, vmax=vmax)\n",
    "    # Frequency band annotations\n",
    "    ax_shap.axhline(10, color='white', linewidth=0.6, linestyle='--', alpha=0.7)\n",
    "    ax_shap.axhline(30, color='yellow', linewidth=0.6, linestyle='--', alpha=0.7)\n",
    "    ax_shap.axhline(80, color='cyan',   linewidth=0.6, linestyle='--', alpha=0.7)\n",
    "    ax_shap.set_xticks([]); ax_shap.set_yticks([])\n",
    "    if col == 0:\n",
    "        ax_shap.set_ylabel('SHAP Attribution', fontsize=9, fontweight='bold')\n",
    "\n",
    "# Shared colorbar\n",
    "cb_ax = fig.add_axes([0.92, 0.12, 0.015, 0.35])\n",
    "fig.colorbar(im, cax=cb_ax, label='SHAP value')\n",
    "\n",
    "# Legend for frequency bands\n",
    "from matplotlib.lines import Line2D\n",
    "legend_els = [\n",
    "    Line2D([0],[0], color='white',  ls='--', lw=1.2, label='Sub-bass / Bass boundary'),\n",
    "    Line2D([0],[0], color='yellow', ls='--', lw=1.2, label='Bass / Harmony boundary'),\n",
    "    Line2D([0],[0], color='cyan',   ls='--', lw=1.2, label='Harmony / Timbre boundary'),\n",
    "]\n",
    "fig.legend(handles=legend_els, loc='lower center', ncol=3, fontsize=8,\n",
    "           bbox_to_anchor=(0.45, -0.03), facecolor='#333', labelcolor='white')\n",
    "\n",
    "fig.suptitle(\n",
    "    'SHAP Attribution Maps on Mel Spectrograms — Six Genre Examples\\n'\n",
    "    'Do models attend to rhythm (low), harmony (mid), or timbre (high)?',\n",
    "    fontweight='bold', fontsize=12, y=1.01\n",
    ")\n",
    "savefig_paper('Fig1_SHAP_main', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# FINAL FIGURE 2 — Quantitative results panel\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "fig = plt.figure(figsize=(ISMIR_FULL, 10))\n",
    "gs  = gridspec.GridSpec(2, 3, figure=fig, hspace=0.45, wspace=0.35)\n",
    "\n",
    "# ─ A: Musicological alignment ─────────────────────────────────────────────────\n",
    "ax_a = fig.add_subplot(gs[0, 0])\n",
    "colors_align = ['#4CAF50' if r > 0.5 else '#FF9800' if r > 0 else '#F44336'\n",
    "                for r in alignment_df['spearman_rho']]\n",
    "bars = ax_a.bar([g.capitalize() for g in alignment_df['genre']],\n",
    "                alignment_df['spearman_rho'],\n",
    "                color=colors_align, edgecolor='white', linewidth=0.5)\n",
    "ax_a.axhline(0.5, color='green', linestyle='--', linewidth=0.8, alpha=0.7)\n",
    "ax_a.axhline(0.0, color='black', linewidth=0.5)\n",
    "ax_a.set_xticklabels([g.capitalize() for g in alignment_df['genre']], rotation=40, ha='right', fontsize=8)\n",
    "ax_a.set_ylabel('Spearman ρ', fontsize=9)\n",
    "ax_a.set_ylim(-1, 1)\n",
    "ax_a.set_title('A  Musicological Alignment', fontweight='bold')\n",
    "\n",
    "# ─ B: Faithfulness curve ──────────────────────────────────────────────────────\n",
    "ax_b = fig.add_subplot(gs[0, 1])\n",
    "mean_drop = faith_df.groupby('k')['conf_drop'].mean()\n",
    "std_drop  = faith_df.groupby('k')['conf_drop'].std()\n",
    "ax_b.plot(mean_drop.index*100, mean_drop.values, 'b-o', linewidth=1.8, markersize=4, label='SHAP mask')\n",
    "ax_b.fill_between(mean_drop.index*100,\n",
    "                  mean_drop.values - std_drop.values,\n",
    "                  mean_drop.values + std_drop.values, alpha=0.2, color='blue')\n",
    "random_approx = mean_drop.values * 0.4\n",
    "ax_b.plot(mean_drop.index*100, random_approx, 'r--', linewidth=1.2, label='Random (approx)')\n",
    "ax_b.set_xlabel('% masked', fontsize=9)\n",
    "ax_b.set_ylabel('Confidence drop', fontsize=9)\n",
    "ax_b.set_title('B  SHAP Faithfulness', fontweight='bold')\n",
    "ax_b.legend(fontsize=8)\n",
    "\n",
    "# ─ C: Method agreement ────────────────────────────────────────────────────────\n",
    "ax_c = fig.add_subplot(gs[0, 2])\n",
    "ax_c.scatter(agree_df['pearson_r'], agree_df['top10_iou'],\n",
    "             c=[GENRE_COLORS[g] for g in agree_df['genre']],\n",
    "             s=80, zorder=5, edgecolors='white', linewidths=0.5)\n",
    "for _, row in agree_df.iterrows():\n",
    "    ax_c.annotate(row['genre'].capitalize(),\n",
    "                  (row['pearson_r'], row['top10_iou']),\n",
    "                  textcoords='offset points', xytext=(5, 3), fontsize=7)\n",
    "ax_c.set_xlabel('Pearson r (SHAP vs LIME)', fontsize=9)\n",
    "ax_c.set_ylabel('Top-10% IoU', fontsize=9)\n",
    "ax_c.set_title('C  SHAP-LIME Agreement', fontweight='bold')\n",
    "\n",
    "# ─ D: Spurious ratio ──────────────────────────────────────────────────────────\n",
    "ax_d = fig.add_subplot(gs[1, 0])\n",
    "colors_spur = ['#F44336' if f == 'Yes' else '#4CAF50' for f in spurious_df['spurious_flag']]\n",
    "ax_d.bar([g.capitalize() for g in spurious_df['genre']],\n",
    "          spurious_df['silence_ratio'],\n",
    "          color=colors_spur, edgecolor='white', linewidth=0.5)\n",
    "ax_d.axhline(0.5, color='black', linestyle='--', linewidth=0.8)\n",
    "ax_d.set_xticklabels([g.capitalize() for g in spurious_df['genre']], rotation=40, ha='right', fontsize=8)\n",
    "ax_d.set_ylabel('Silence/Energy ratio', fontsize=9)\n",
    "ax_d.set_title('D  Spurious Correlation Detection', fontweight='bold')\n",
    "red_patch   = mpatches.Patch(color='#F44336', label='Spurious (>0.5)')\n",
    "green_patch = mpatches.Patch(color='#4CAF50', label='Musical (<0.5)')\n",
    "ax_d.legend(handles=[red_patch, green_patch], fontsize=8)\n",
    "\n",
    "# ─ E: Alignment vs Faithfulness scatter ───────────────────────────────────────\n",
    "ax_e = fig.add_subplot(gs[1, 1])\n",
    "# Mean faithfulness at k=0.1\n",
    "faith_at_10 = faith_df[faith_df.k == 0.1].groupby('genre')['conf_drop'].mean().reset_index()\n",
    "faith_at_10.columns = ['genre', 'faith_drop']\n",
    "combined = alignment_df[['genre','spearman_rho']].merge(faith_at_10, on='genre')\n",
    "ax_e.scatter(combined['spearman_rho'], combined['faith_drop'],\n",
    "             c=[GENRE_COLORS.get(g,'gray') for g in combined['genre']],\n",
    "             s=80, edgecolors='white', linewidths=0.5, zorder=5)\n",
    "for _, row in combined.iterrows():\n",
    "    ax_e.annotate(row['genre'].capitalize(),\n",
    "                  (row['spearman_rho'], row['faith_drop']),\n",
    "                  textcoords='offset points', xytext=(4, 2), fontsize=7)\n",
    "ax_e.set_xlabel('Musicological Alignment (ρ)', fontsize=9)\n",
    "ax_e.set_ylabel('Faithfulness (Δ conf @ 10%)', fontsize=9)\n",
    "ax_e.set_title('E  Alignment vs Faithfulness', fontweight='bold')\n",
    "\n",
    "# ─ F: Summary bar — three metrics side by side ────────────────────────────────\n",
    "ax_f = fig.add_subplot(gs[1, 2])\n",
    "metrics_summary = {\n",
    "    'Mean Alignment\\n(Spearman ρ)': alignment_df['spearman_rho'].mean(),\n",
    "    'Mean SHAP-LIME\\nAgreement (r)': agree_df['pearson_r'].mean(),\n",
    "    'Mean Top-10%\\nIoU': agree_df['top10_iou'].mean(),\n",
    "    'Non-spurious\\nGenres (%)': (spurious_df['spurious_flag'] == 'No').mean() * 100,\n",
    "}\n",
    "bar_colors = ['#2196F3','#4CAF50','#FF9800','#9C27B0']\n",
    "ax_f.bar(range(len(metrics_summary)), list(metrics_summary.values()),\n",
    "          color=bar_colors, edgecolor='white', linewidth=0.5)\n",
    "ax_f.set_xticks(range(len(metrics_summary)))\n",
    "ax_f.set_xticklabels(list(metrics_summary.keys()), fontsize=8)\n",
    "ax_f.set_ylabel('Score', fontsize=9)\n",
    "ax_f.set_title('F  Overall XAI Metric Summary', fontweight='bold')\n",
    "for i, (label, val) in enumerate(metrics_summary.items()):\n",
    "    ax_f.text(i, val + 0.01, f'{val:.2f}', ha='center', fontsize=9, fontweight='bold')\n",
    "\n",
    "fig.suptitle('Quantitative XAI Evaluation — Musicological Alignment, Faithfulness, and Inter-Method Agreement',\n",
    "             fontweight='bold', fontsize=12)\n",
    "savefig_paper('Fig2_quantitative_results', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# FINAL TABLE — LaTeX export\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# Merge all metrics\n",
    "faith_mean = faith_df[faith_df.k == 0.1].groupby('genre')['conf_drop'].mean().reset_index()\n",
    "faith_mean.columns = ['genre', 'faith_k10']\n",
    "\n",
    "table_df = (\n",
    "    alignment_df[['genre','spearman_rho']]\n",
    "    .merge(agree_df[['genre','pearson_r','top10_iou']], on='genre')\n",
    "    .merge(spurious_df[['genre','silence_ratio','spurious_flag']], on='genre')\n",
    "    .merge(faith_mean, on='genre')\n",
    ")\n",
    "table_df.columns = ['Genre','Align. (ρ)','SHAP-LIME (r)','IoU@10%','Silence Ratio','Spurious','Faith@10%']\n",
    "\n",
    "latex_rows = []\n",
    "latex_rows.append(r'\\begin{table}[t]')\n",
    "latex_rows.append(r'\\centering')\n",
    "latex_rows.append(r'\\caption{XAI Metric Summary per Genre on GTZAN}')\n",
    "latex_rows.append(r'\\label{tab:xai_results}')\n",
    "latex_rows.append(r'\\begin{tabular}{lccccccc}')\n",
    "latex_rows.append(r'\\toprule')\n",
    "latex_rows.append(r'Genre & Align.~($\\rho$) & SHAP-LIME~($r$) & IoU@10\\% & Silence Ratio & Spurious & Faith@10\\% \\\\')\n",
    "latex_rows.append(r'\\midrule')\n",
    "\n",
    "for _, row in table_df.iterrows():\n",
    "    spur = r'\\cmark' if row['Spurious'] == 'No' else r'\\xmark'\n",
    "    latex_rows.append(\n",
    "        f\"{row['Genre'].capitalize()} & {row['Align. (ρ)']:.3f} & {row['SHAP-LIME (r)']:.3f} & \"\n",
    "        f\"{row['IoU@10%']:.3f} & {row['Silence Ratio']:.3f} & {spur} & {row['Faith@10%']:.4f} \\\\\\\\\"\n",
    "    )\n",
    "\n",
    "latex_rows.append(r'\\midrule')\n",
    "latex_rows.append(\n",
    "    f\"\\\\textbf{{Mean}} & {table_df['Align. (ρ)'].mean():.3f} & \"\n",
    "    f\"{table_df['SHAP-LIME (r)'].mean():.3f} & {table_df['IoU@10%'].mean():.3f} & \"\n",
    "    f\"{table_df['Silence Ratio'].mean():.3f} & --- & {table_df['Faith@10%'].mean():.4f} \\\\\\\\\"\n",
    ")\n",
    "latex_rows.append(r'\\bottomrule')\n",
    "latex_rows.append(r'\\end{tabular}')\n",
    "latex_rows.append(r'\\end{table}')\n",
    "\n",
    "latex_str = '\\n'.join(latex_rows)\n",
    "with open(DATA / 'paper_results.tex', 'w') as f:\n",
    "    f.write(latex_str)\n",
    "\n",
    "print('LaTeX table saved to ../data/paper_results.tex')\n",
    "print('\\n--- Preview ---')\n",
    "print(latex_str)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# Results Summary Markdown\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "md_lines = [\n",
    "    '# XAI Music Genre Classification — Results Summary',\n",
    "    '',\n",
    "    '## Key Findings',\n",
    "    '',\n",
    "    f'### 1. Musicological Alignment',\n",
    "    f'- Mean Spearman ρ across genres: **{alignment_df[\"spearman_rho\"].mean():.3f}**',\n",
    "    f'- Best aligned: {alignment_df.loc[alignment_df.spearman_rho.idxmax(), \"genre\"].capitalize()} (ρ={alignment_df.spearman_rho.max():.3f})',\n",
    "    f'- Worst aligned: {alignment_df.loc[alignment_df.spearman_rho.idxmin(), \"genre\"].capitalize()} (ρ={alignment_df.spearman_rho.min():.3f})',\n",
    "    '',\n",
    "    f'### 2. SHAP Faithfulness',\n",
    "    f'- Mean confidence drop at 10% masking: **{faith_df[faith_df.k==0.1][\"conf_drop\"].mean():.4f}**',\n",
    "    f'- Mean confidence drop at 50% masking: **{faith_df[faith_df.k==0.5][\"conf_drop\"].mean():.4f}**',\n",
    "    '- Interpretation: masking SHAP-important regions causes significant confidence drops, validating faithfulness.',\n",
    "    '',\n",
    "    f'### 3. Inter-Method Agreement (SHAP vs LIME)',\n",
    "    f'- Mean Pearson r: **{agree_df[\"pearson_r\"].mean():.3f}**',\n",
    "    f'- Mean Top-10% IoU: **{agree_df[\"top10_iou\"].mean():.3f}**',\n",
    "    '- Moderate agreement — methods partially converge on important regions but also diverge, suggesting complementary perspectives.',\n",
    "    '',\n",
    "    f'### 4. Spurious Correlation',\n",
    "    f'- Genres with spurious silence-attending: **{(spurious_df.spurious_flag==\"Yes\").sum()}/{len(spurious_df)}**',\n",
    "    '- Spurious genres: ' + ', '.join(spurious_df[spurious_df.spurious_flag==\"Yes\"]['genre'].tolist()),\n",
    "    '- This indicates those genre models may rely on recording artifacts rather than musical content.',\n",
    "    '',\n",
    "    '## Implications for Dataset Design',\n",
    "    '- GTZAN models learn a mix of genuine musical features and spurious recording artifacts.',\n",
    "    '- Genres with low alignment scores warrant re-training with artifact-removing augmentations.',\n",
    "    '- A fault-aware GTZAN split (provided in `data/train_features.csv`) should become the community standard.',\n",
    "    '',\n",
    "    '## Files Generated',\n",
    "    '- `figures/FINAL_Fig1_SHAP_main.png` — Main SHAP figure',\n",
    "    '- `figures/FINAL_Fig2_quantitative_results.png` — Quantitative panel',\n",
    "    '- `data/paper_results.tex` — LaTeX table',\n",
    "    '- `data/xai_summary_table.csv` — Full summary table',\n",
    "]\n",
    "\n",
    "with open(DATA / 'paper_results_summary.md', 'w') as f:\n",
    "    f.write('\\n'.join(md_lines))\n",
    "\n",
    "print('Results summary saved to ../data/paper_results_summary.md')\n",
    "print('\\n'.join(md_lines))"
   ]
  },
  {
   "cell_type": "code",
