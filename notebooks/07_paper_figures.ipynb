   "outputs": [],
   "source": [
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# Figure inventory — list all generated figures\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "all_figs = sorted(FIGURES.glob('*.png'))\n",
