    "# Notebook 04 — LIME Explanations for Audio Classification\n",
    "### XAI for Music Genre Classification | GTZAN Dataset\n",
    "---\n",
    "**Purpose:** Apply LIME (Local Interpretable Model-agnostic Explanations) to explain individual clip classifications by perturbing spectrogram superpixel segments and measuring prediction change.\n",
    "\n",
    "**Key difference from SHAP:**\n",
    "- LIME is *local* and *model-agnostic* — works by masking superpixel regions\n",
    "- SHAP is *global* and *model-specific* (via DeepExplainer)\n",
    "- Comparing both lets us measure explanation stability (inter-method agreement)\n",
    "\n",
    "**Outputs:**\n",
    "- `../figures/04_lime_*.png` — HD LIME overlays\n",
    "- `../data/lime_results.pkl` — superpixel importance scores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, sys\n",
    "for pkg in ['lime', 'scikit-image', 'torch', 'librosa', 'numpy',\n",
    "            'pandas', 'matplotlib', 'seaborn', 'tqdm']:\n",
    "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', pkg])\n",
    "print('Done.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, pickle, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "from skimage.segmentation import slic, mark_boundaries\n",
    "from lime import lime_image\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 300, 'savefig.dpi': 300,\n",
    "    'font.family': 'DejaVu Sans', 'font.size': 12,\n",
    "    'axes.titlesize': 13, 'axes.labelsize': 12,\n",
    "    'axes.spines.top': False, 'axes.spines.right': False,\n",
    "})\n",
    "\n",
    "FIGURES = Path('../figures')\n",
    "MODELS  = Path('../models')\n",
    "DATA    = Path('../data')\n",
    "\n",
    "DEVICE = ('mps' if torch.backends.mps.is_available() else\n",
    "          'cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "GENRES = ['blues','classical','country','disco','hiphop',\n",
    "          'jazz','metal','pop','reggae','rock']\n",
    "\n",
    "SR, N_MELS, HOP, N_FFT = 22050, 128, 512, 2048\n",
    "SEG_S, FIXED_W = 3.0, 128\n",
    "\n",
    "shap_cmap = LinearSegmentedColormap.from_list(\n",
    "    'shap_audio', ['#1565C0','#BBDEFB','#FFFFFF','#FFCDD2','#C62828']\n",
    ")\n",
    "\n",
    "def savefig(name, fig=None):\n",
    "    if fig is None: fig = plt.gcf()\n",
    "    path = FIGURES / f'{name}.png'\n",
    "    fig.savefig(path, dpi=300, bbox_inches='tight', facecolor='white')\n",
    "    print(f'  ✓ Saved {path}')\n",
    "    plt.show()\n",
    "\n",
    "print(f'Device: {DEVICE}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Load model ────────────────────────────────────────────────────────────────\n",
    "class MusicCNN(nn.Module):\n",
    "    def __init__(self, n_classes=10, dropout=0.4):\n",
    "        super().__init__()\n",
    "        def conv_block(in_ch, out_ch):\n",
    "            return nn.Sequential(\n",
    "                nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),\n",
    "                nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\n",
    "                nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),\n",
    "                nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\n",
    "                nn.MaxPool2d(2), nn.Dropout2d(p=0.15),\n",
    "            )\n",
    "        self.block1 = conv_block(1, 32)\n",
    "        self.block2 = conv_block(32, 64)\n",
    "        self.block3 = conv_block(64, 128)\n",
    "        self.pool   = nn.AdaptiveAvgPool2d((4, 4))\n",
    "        self.flat   = nn.Flatten()\n",
    "        self.head   = nn.Sequential(\n",
    "            nn.Linear(128*4*4, 256), nn.ReLU(inplace=True),\n",
    "            nn.Dropout(dropout), nn.Linear(256, n_classes)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        x = self.block1(x); x = self.block2(x); x = self.block3(x)\n",
    "        return self.head(self.flat(self.pool(x)))\n",
    "\n",
    "model = MusicCNN().to(DEVICE)\n",
    "model.load_state_dict(torch.load(MODELS / 'cnn_gtzan_best.pt', map_location=DEVICE))\n",
    "model.eval()\n",
    "\n",
    "with open(MODELS / 'label_encoder.pkl', 'rb') as f:\n",
    "    le = pickle.load(f)\n",
    "print('Model loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── LIME prediction function (expects RGB-ish 3D input from lime_image) ───────\n",
    "def lime_predict_fn(images_np):\n",
    "    \"\"\"\n",
    "    images_np: (N, H, W, 3) float array from LIME (uses first channel only)\n",
    "    Returns softmax probabilities (N, 10)\n",
    "    \"\"\"\n",
    "    batch = torch.tensor(\n",
    "        images_np[:, :, :, 0:1].transpose(0, 3, 1, 2),\n",
    "        dtype=torch.float32\n",
    "    ).to(DEVICE)  # (N, 1, H, W)\n",
    "    with torch.no_grad():\n",
    "        logits = model(batch)\n",
    "        probs  = F.softmax(logits, dim=-1).cpu().numpy()\n",
    "    return probs\n",
    "\n",
    "def load_spectrogram(filepath, start_s=0.0):\n",
    "    y, _ = librosa.load(filepath, sr=SR, offset=start_s, duration=SEG_S)\n",
    "    if len(y) < int(SEG_S * SR):\n",
    "        y = np.pad(y, (0, int(SEG_S * SR) - len(y)))\n",
    "    S    = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=N_MELS, n_fft=N_FFT, hop_length=HOP)\n",
    "    S_db = librosa.power_to_db(S, ref=np.max)\n",
    "    S_db = (S_db - S_db.min()) / (S_db.max() - S_db.min() + 1e-8)\n",
    "    if S_db.shape[1] != FIXED_W:\n",
    "        from skimage.transform import resize\n",
    "        S_db = resize(S_db, (N_MELS, FIXED_W), anti_aliasing=True)\n",
    "    return S_db  # (128, 128) float [0,1]\n",
    "\n",
    "explainer = lime_image.LimeImageExplainer()\n",
    "print('LIME explainer ready.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Compute LIME explanations for one correct clip per genre ──────────────────\n",
    "preds_df = pd.read_csv(DATA / 'test_predictions.csv')\n",
    "lime_results = {}\n",
    "\n",
    "N_SAMPLES   = 500   # LIME perturbation samples — increase to 1000 for final paper\n",
    "N_SEGMENTS  = 40    # SLIC superpixels\n",
    "\n",
    "for genre in tqdm(GENRES, desc='Computing LIME'):\n",
    "    correct = preds_df[(preds_df.true_genre == genre) &\n",
    "                       (preds_df.pred_genre == genre) &\n",
    "                       (preds_df.fault == 'clean')]\n",
    "    if correct.empty:\n",
    "        continue\n",
    "    row = correct.iloc[0]\n",
    "    try:\n",
    "        spec = load_spectrogram(row.filepath)  # (128,128)\n",
    "        # LIME needs (H, W, 3)\n",
    "        spec_rgb = np.stack([spec, spec, spec], axis=-1)\n",
    "\n",
    "        explanation = explainer.explain_instance(\n",
    "            spec_rgb,\n",
    "            lime_predict_fn,\n",
    "            top_labels=1,\n",
    "            hide_color=0,\n",
    "            num_samples=N_SAMPLES,\n",
    "            segmentation_fn=lambda img: slic(img, n_segments=N_SEGMENTS,\n",
    "                                              compactness=0.1, sigma=1, start_label=1)\n",
    "        )\n",
    "        genre_idx = le.transform([genre])[0]\n",
    "        segments  = explanation.segments\n",
    "        # Get importance per segment\n",
    "        local_exp = dict(explanation.local_exp[genre_idx])\n",
    "        importance_map = np.zeros_like(spec, dtype=float)\n",
    "        for seg_id, weight in local_exp.items():\n",
    "            importance_map[segments == seg_id] = weight\n",
    "\n",
    "        lime_results[genre] = {\n",
    "            'spec':           spec,\n",
    "            'importance_map': importance_map,\n",
    "            'segments':       segments,\n",
    "            'local_exp':      local_exp,\n",
    "            'filepath':       row.filepath,\n",
    "        }\n",
    "    except Exception as e:\n",
    "        print(f'  Error {genre}: {e}')\n",
    "\n",
    "with open(DATA / 'lime_results.pkl', 'wb') as f:\n",
    "    pickle.dump(lime_results, f)\n",
    "print(f'LIME done for {len(lime_results)} genres.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 15 — LIME superpixel gallery ───────────────────────────────────────\n",
    "genres_ok = [g for g in GENRES if g in lime_results]\n",
    "ncols, nrows = 5, 2\n",
    "\n",
    "fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 4, nrows * 4.2))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, genre in enumerate(genres_ok):\n",
    "    d   = lime_results[genre]\n",
    "    spec = d['spec']\n",
    "    imp  = d['importance_map']\n",
    "    segs = d['segments']\n",
    "\n",
    "    ax  = axes[i]\n",
    "    ax.imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.8)\n",
    "    vmax = np.abs(imp).max() + 1e-8\n",
    "    im = ax.imshow(imp, aspect='auto', origin='lower',\n",
    "                   cmap=shap_cmap, alpha=0.70, vmin=-vmax, vmax=vmax)\n",
    "\n",
    "    # Draw segment boundaries\n",
    "    boundaries = mark_boundaries(np.stack([spec]*3, -1), segs, color=(1,1,0), mode='thick')\n",
    "    # Overlay boundaries as yellow contour\n",
    "    boundary_mask = (boundaries[:,:,0] > 0.8) & (boundaries[:,:,1] > 0.8)\n",
    "    ax.contour(boundary_mask, levels=[0.5], colors='yellow', linewidths=0.5, alpha=0.6)\n",
    "\n",
    "    ax.set_title(genre.capitalize(), fontweight='bold')\n",
    "    ax.set_xticks([]); ax.set_yticks([])\n",
    "\n",
    "for j in range(i+1, len(axes)):\n",
    "    axes[j].set_visible(False)\n",
    "\n",
    "fig.colorbar(im, ax=axes[:len(genres_ok)], orientation='vertical',\n",
    "             fraction=0.015, pad=0.02, label='LIME importance (positive = genre-driving)')\n",
    "fig.suptitle(\n",
    "    'Figure 15 — LIME Superpixel Attribution Maps\\n'\n",
    "    '(Yellow lines = SLIC segment boundaries | Red = drives | Blue = suppresses)',\n",
    "    fontweight='bold'\n",
    ")\n",
    "savefig('04_lime_gallery', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 16 — Top positive vs negative superpixels for Blues & Metal ────────\n",
    "focus_genres = ['blues', 'metal']\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "for row_i, genre in enumerate(focus_genres):\n",
    "    if genre not in lime_results:\n",
    "        continue\n",
    "    d    = lime_results[genre]\n",
    "    spec = d['spec']\n",
    "    segs = d['segments']\n",
    "    lexp = d['local_exp']\n",
    "\n",
    "    sorted_exp = sorted(lexp.items(), key=lambda x: x[1])\n",
    "    top_pos  = [k for k,v in sorted_exp if v >  0][-5:]\n",
    "    top_neg  = [k for k,v in sorted_exp if v <= 0][:5]\n",
    "\n",
    "    def make_mask(seg_ids):\n",
    "        m = np.zeros_like(spec)\n",
    "        for sid in seg_ids:\n",
    "            m[segs == sid] = 1.0\n",
    "        return m\n",
    "\n",
    "    for col_i, (mask_ids, color, label) in enumerate([\n",
    "        (top_pos, '#C62828', 'Top 5 positive (drives genre)'),\n",
    "        (top_neg, '#1565C0', 'Top 5 negative (suppresses genre)'),\n",
    "    ]):\n",
    "        ax = axes[row_i, col_i]\n",
    "        ax.imshow(spec, aspect='auto', origin='lower', cmap='gray_r', alpha=0.85)\n",
    "        mask = make_mask(mask_ids)\n",
    "        colored = np.zeros((*spec.shape, 4))\n",
    "        import matplotlib.colors as mcolors\n",
    "        rgb = mcolors.to_rgb(color)\n",
    "        colored[:,:,0] = rgb[0]\n",
    "        colored[:,:,1] = rgb[1]\n",
    "        colored[:,:,2] = rgb[2]\n",
    "        colored[:,:,3] = mask * 0.6\n",
    "        ax.imshow(colored, aspect='auto', origin='lower')\n",
    "        ax.set_title(f'{genre.capitalize()} — {label}', fontweight='bold', fontsize=10)\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "\n",
    "fig.suptitle('Figure 16 — LIME Top Positive & Negative Superpixels', fontweight='bold')\n",
    "savefig('04_lime_top_segments', fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Figure 17 — LIME frequency band importance (same as SHAP NB for comparison) ─\n",
    "bands = {\n",
    "    'Sub-bass':  (0, 10),\n",
    "    'Bass/Rhythm':(10, 30),\n",
    "    'Harmony':   (30, 80),\n",
    "    'Timbre':    (80, 128),\n",
    "}\n",
    "\n",
    "band_data = []\n",
    "for genre in GENRES:\n",
    "    if genre not in lime_results:\n",
    "        continue\n",
    "    imp = lime_results[genre]['importance_map']\n",
    "    for band_name, (lo, hi) in bands.items():\n",
    "        band_data.append({\n",
    "            'genre': genre,\n",
    "            'band': band_name,\n",
    "            'mean_pos_importance': np.clip(imp[lo:hi], 0, None).mean()\n",
    "        })\n",
    "\n",
    "band_df = pd.DataFrame(band_data)\n",
    "pivot   = band_df.pivot(index='genre', columns='band',\n",
    "                         values='mean_pos_importance').reindex(GENRES).dropna()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 7))\n",
    "pivot.plot(kind='bar', ax=ax, colormap='Blues', edgecolor='white', linewidth=0.5)\n",
    "ax.set_xticklabels([g.capitalize() for g in pivot.index], rotation=30, ha='right')\n",
    "ax.set_ylabel('Mean Positive LIME Importance')\n",
    "ax.set_title('Figure 17 — LIME Mean Positive Importance per Frequency Band per Genre', fontweight='bold')\n",
    "ax.legend(title='Band', bbox_to_anchor=(1.01, 1), loc='upper left')\n",
    "savefig('04_lime_frequency_bands', fig)"
   ]
  }
